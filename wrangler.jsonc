{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ddz",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "ddz.646474.xyz",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ddz-db",
      "database_id": "540a8da1-7888-443a-ad0b-7b3c781d9493"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
