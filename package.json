{
  "name": "ddz-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "欢乐斗地主风格 · 网页版在线斗地主（Cloudflare Workers + Durable Objects + D1）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit false && vite build",
    "build:client": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "db:local": "wrangler d1 execute ddz-db --local --file=./worker/schema.sql",
    "db:remote": "wrangler d1 execute ddz-db --remote --file=./worker/schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.65.0",
    "typescript": "^5.5.4",
    "undici": "^6.29.1",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "wrangler": "^3.78.0"
  }
}
